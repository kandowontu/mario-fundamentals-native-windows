#define IDI_APP 1
#define IDB_TITLE 101
#define IDB_CREDITS 102
#define IDB_BRAINSTORM 103
#define IDB_BRAINSTORM_FADE 104
#define IDB_STEPPING_STONE 105
#define IDB_STEPPING_STONE_FADE 106
#define IDB_HELP_BACKGAMMON_1 110
#define IDB_HELP_BACKGAMMON_2 111
#define IDB_HELP_DOMINOES_1 112
#define IDB_HELP_DOMINOES_2 113
#define IDB_HELP_CHECKERS_1 114
#define IDB_HELP_GOFISH_1 115
#define IDB_HELP_GOFISH_2 116
#define IDB_HELP_YACHT_1 117
#define IDB_HELP_YACHT_2 118
#define IDR_ASSET_PACK 201
#define IDR_FONT_TIMES_14 202
#define IDR_FONT_GENEVA_9 203
#define IDR_FONT_MONACO_12 204
#define IDR_DOS_ASSET_PACK 205

// Generated BMP assets use the resource-safe 40-byte BITMAPINFOHEADER format.
IDI_APP ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/app.ico"
IDB_TITLE BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/assets/title.bmp"
IDB_CREDITS BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/assets/credits.bmp"
IDB_BRAINSTORM BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/assets/startup/brainstorm.bmp"
IDB_BRAINSTORM_FADE BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/assets/startup/brainstorm-fade.bmp"
IDB_STEPPING_STONE BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/assets/startup/stepping-stone.bmp"
IDB_STEPPING_STONE_FADE BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/assets/startup/stepping-stone-fade.bmp"
IDB_HELP_BACKGAMMON_1 BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/assets/help/backgammon-1.bmp"
IDB_HELP_BACKGAMMON_2 BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/assets/help/backgammon-2.bmp"
IDB_HELP_DOMINOES_1 BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/assets/help/dominoes-1.bmp"
IDB_HELP_DOMINOES_2 BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/assets/help/dominoes-2.bmp"
IDB_HELP_CHECKERS_1 BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/assets/help/checkers-1.bmp"
IDB_HELP_GOFISH_1 BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/assets/help/gofish-1.bmp"
IDB_HELP_GOFISH_2 BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/assets/help/gofish-2.bmp"
IDB_HELP_YACHT_1 BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/assets/help/yacht-1.bmp"
IDB_HELP_YACHT_2 BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/assets/help/yacht-2.bmp"
IDR_ASSET_PACK RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/MarioFundamentals.pack"
IDR_FONT_TIMES_14 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/fonts/times-14.nfnt"
IDR_FONT_GENEVA_9 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/fonts/geneva-9.nfnt"
IDR_FONT_MONACO_12 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/fonts/monaco-12.nfnt"
IDR_DOS_ASSET_PACK RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/MarioGameGallery.pack"
1 24 "@CMAKE_CURRENT_SOURCE_DIR@/src/app.manifest"

1 VERSIONINFO
 FILEVERSION 2,0,1,0
 PRODUCTVERSION 2,0,1,0
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BrainStorm / Stepping Stone; native preservation port"
            VALUE "FileDescription", "Mario's Game Gallery / FUNdamentals native Windows collection"
            VALUE "FileVersion", "2.0.1"
            VALUE "InternalName", "MarioFundamentals"
            VALUE "OriginalFilename", "MarioFundamentals.exe"
            VALUE "ProductName", "Mario's Game Gallery / FUNdamentals"
            VALUE "ProductVersion", "2.0.1 dual-edition compatibility port"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
